# Tombola frontend — example environment.
# Copy to `.env.local` and fill in. Vercel sets these per-deployment.

# Solana RPC endpoint. Devnet by default; rotate to mainnet pre-launch.
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"

# ──────────────────────────────────────────────────────────────────────
# Upstash Redis — off-chain profile / friend / pool-invite storage.
# Vercel's Upstash integration injects KV_REST_API_*; a manual Upstash
# signup uses UPSTASH_REDIS_REST_*. Either pair works.
# ──────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ──────────────────────────────────────────────────────────────────────
# Keeper cron — Vercel Cron Authorization header.
# Sign /api/keeper/tick with `Bearer $CRON_SECRET`.
# ──────────────────────────────────────────────────────────────────────
CRON_SECRET=""

# ──────────────────────────────────────────────────────────────────────
# Admin dashboard (/admin/*).
#
# ADMIN_WALLETS:  comma-separated base58 pubkeys that may sign into the
#                 admin console. Empty = dashboard inaccessible.
# ADMIN_SESSION_SECRET:  HMAC key for the admin session cookie.
#                        Generate with `openssl rand -hex 32`.
#                        Minimum 32 chars enforced at runtime.
# ──────────────────────────────────────────────────────────────────────
ADMIN_WALLETS=""
ADMIN_SESSION_SECRET=""

# Optional: the wallet that ran scripts/deploy.ts (initialize_protocol).
# When set, the admin treasury page compares against ProtocolConfig.
# treasury + the BPF upgrade authority and surfaces a "ROTATION
# PENDING" banner until both have been rotated to a Squads multisig
# (see DESIGN_DECISIONS.md D-009). Leave unset to skip the check.
DEPLOYER_PUBKEY=""

# ──────────────────────────────────────────────────────────────────────
# Admin risk thresholds (all optional — sensible defaults baked in).
# Adjust without redeploy by editing env on Vercel; values are read
# per request.
# ──────────────────────────────────────────────────────────────────────
RISK_STUCK_THRESHOLD_SEC=""              # default 3600 (1h)
RISK_CONCENTRATED_STAKE_PCT=""           # default 80
RISK_SELF_DEAL_OWNER_PCT=""              # default 50
RISK_BIG_SPENDER_LAMPORTS=""             # default 50000000000 (50 SOL)
RISK_HIGH_ACTIVITY_POOL_COUNT=""         # default 25
RISK_UNCLAIMED_HIGH_SPEND_LAMPORTS=""    # default 10000000000 (10 SOL)

# ──────────────────────────────────────────────────────────────────────
# Admin webhook alerts. Fires on high-severity risk flags via the
# /api/admin/cron/alert-scan cron (every 5 min). Vendor-agnostic —
# Discord, Slack and generic JSON receivers all work.
# ──────────────────────────────────────────────────────────────────────
ADMIN_ALERT_WEBHOOK_URL=""               # leave empty to disable
ADMIN_ALERT_DEDUPE_HOURS=""              # default 6
