# Solana RPC endpoint (defaults to devnet if unset)
NEXT_PUBLIC_SOLANA_RPC_URL=

# Phantom Connect — get app ID from https://phantom.com/portal
NEXT_PUBLIC_PHANTOM_APP_ID=

# Stripe Crypto Onramp — get keys from https://dashboard.stripe.com
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_ONRAMP_PUBLISHABLE_KEY=

# RaaS recurring-raffle cron auth secret (set same value in Vercel env)
# Used as Bearer token to authenticate /api/r/cron/schedules calls.
CRON_SECRET=

# RaaS operator allow-list — comma-separated base58 wallet pubkeys.
# Wallets listed here can access /r/_ops/* operator admin routes.
RAAS_OPERATOR_WALLETS=
