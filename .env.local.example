# Solana RPC endpoint (defaults to devnet if unset)
NEXT_PUBLIC_SOLANA_RPC_URL=

# Phantom Connect — get app ID from https://phantom.com/portal
NEXT_PUBLIC_PHANTOM_APP_ID=

# Stripe Crypto Onramp — get keys from https://dashboard.stripe.com
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_ONRAMP_PUBLISHABLE_KEY=
