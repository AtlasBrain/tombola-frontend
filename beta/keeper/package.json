{
  "name": "@tombola/keeper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.mjs --packages=external",
    "start": "npm run build && node dist/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/kit": "^6.9.0",
    "@solana/web3.js": "^1.98.4",
    "@switchboard-xyz/on-demand": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
