{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@tombola/sdk": ["../../vendor/sdk/index.ts"],
      "@tombola/sdk/*": ["../../vendor/sdk/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
